{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Thông tin hồ sơ, tùy chọn và cài đặt người dùng",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "authType": { "type": "string", "enum": ["username", "email", "google"] },
        "username": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "Project": {
      "title": "Project",
      "description": "Dự án mã nguồn HTML/CSS/JS được lưu",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "languages": { "type": "array", "items": { "type": "string" } },
        "htmlCode": { "type": "string", "maxLength": 500000 },
        "cssCode": { "type": "string", "maxLength": 200000 },
        "jsCode": { "type": "string", "maxLength": 200000 },
        "isShared": { "type": "boolean" },
        "sharedAt": { "type": "string" },
        "authorEmail": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "LearningProgress": {
      "title": "LearningProgress",
      "description": "Tiến trình học tập lập trình của người dùng",
      "type": "object",
      "properties": {
        "completedLessons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "courseId": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "TemplatePreferences": {
      "title": "TemplatePreferences",
      "description": "Danh sách mẫu yêu thích và các mẫu đã dùng gần đây của người dùng",
      "type": "object",
      "properties": {
        "favorites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recentIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["favorites", "recentIds", "updatedAt"]
    },
    "CollabProject": {
      "title": "CollabProject",
      "description": "Dự án nhóm cộng tác thời gian thực sử dụng Yjs CRDT",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "languages": { "type": "array", "items": { "type": "string" } },
        "ownerId": { "type": "string", "maxLength": 128 },
        "members": { "type": "object" },
        "memberProfiles": { "type": "object" },
        "inviteEnabled": { "type": "boolean" },
        "inviteToken": { "type": "string", "maxLength": 128 },
        "inviteRole": { "type": "string", "enum": ["editor", "viewer"] },
        "inviteExpiresAt": { "type": ["string", "number", "null"] },
        "inviteExpiryPreset": { "type": "string", "enum": ["never", "1h", "24h", "7d"] },
        "inviteRequiresApproval": { "type": "boolean" },
        "joinCode": { "type": ["string", "null"], "maxLength": 4 },
        "joinCodeEnabled": { "type": "boolean" },
        "joinCodeRole": { "type": "string", "enum": ["editor", "viewer"] },
        "joinCodeExpiresAt": { "type": ["string", "number", "null"] },
        "joinCodeExpiryPreset": { "type": "string", "enum": ["15m", "1h", "24h", "never", "7d"] },
        "memberLimit": { "type": "integer" },
        "inviteTokenUsed": { "type": "string", "maxLength": 128 },
        "singleEditorPerAccount": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "ownerId", "members", "memberProfiles", "inviteEnabled", "inviteToken", "inviteRole", "createdAt", "updatedAt"]
    },
    "CollabUpdateChunk": {
      "title": "CollabUpdateChunk",
      "description": "Gói cập nhật Yjs CRDT được đồng bộ theo đợt",
      "type": "object",
      "properties": {
        "updateBase64": { "type": "string" },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "clientId": { "type": "integer" },
        "seq": { "type": "integer" }
      },
      "required": ["updateBase64", "authorId", "createdAt"]
    },
    "CollabSnapshot": {
      "title": "CollabSnapshot",
      "description": "Bản chụp trạng thái nén của tài liệu Yjs",
      "type": "object",
      "properties": {
        "stateBase64": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" },
        "clientId": { "type": "integer" },
        "watermarkAt": { "type": "string" }
      },
      "required": ["stateBase64", "updatedBy", "updatedAt"]
    },
    "CollabInvite": {
      "title": "CollabInvite",
      "description": "Mã thông báo lời mời dự án nhóm (chỉ đọc theo đúng token bí mật)",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "inviteRole": { "type": "string", "enum": ["editor", "viewer"] },
        "inviteEnabled": { "type": "boolean" },
        "projectTitle": { "type": "string", "maxLength": 60 },
        "expiresAt": { "type": ["string", "number", "null"] },
        "requiresApproval": { "type": "boolean" },
        "memberLimit": { "type": "integer" },
        "updatedAt": { "type": "string" }
      },
      "required": ["projectId", "ownerId", "inviteRole", "inviteEnabled", "updatedAt"]
    },
    "CollabLineComment": {
      "title": "CollabLineComment",
      "description": "Chuỗi bình luận gắn theo dòng mã trong dự án nhóm",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "tab": { "type": "string", "enum": ["html", "css", "js"] },
        "lineNumber": { "type": "integer" },
        "relPosJson": { "type": ["string", "null"], "maxLength": 2000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorColor": { "type": "string", "maxLength": 20 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "resolved": { "type": "boolean" },
        "resolvedByName": { "type": ["string", "null"], "maxLength": 100 },
        "resolvedAt": { "type": ["string", "null"], "maxLength": 64 },
        "replies": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "tab", "lineNumber", "authorId", "authorName", "authorColor", "text", "resolved", "replies", "createdAt", "updatedAt"]
    },
    "CollabChatMessage": {
      "title": "CollabChatMessage",
      "description": "Tin nhắn trò chuyện ngắn trong dự án nhóm",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorColor": { "type": "string", "maxLength": 20 },
        "photoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "projectId", "authorId", "authorName", "authorColor", "text", "createdAt"]
    },
    "CollabPreviewState": {
      "title": "CollabPreviewState",
      "description": "Trạng thái chế độ xem trước đồng bộ tùy chọn giữa các thành viên",
      "type": "object",
      "properties": {
        "device": { "type": "string", "enum": ["desktop", "tablet", "mobile"] },
        "refreshNonce": { "type": "integer" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "integer" }
      },
      "required": ["device", "refreshNonce", "updatedByUid", "updatedByName", "updatedAt"]
    },
    "CollabJoinCode": {
      "title": "CollabJoinCode",
      "description": "Tra cứu mã dự án 4 chữ số (không cho phép list, chỉ get khi nhập đúng 4 số)",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "defaultRole": { "type": "string", "enum": ["editor", "viewer"] },
        "enabled": { "type": "boolean" },
        "expiresAt": { "type": ["string", "number", "null"] },
        "expiryPreset": { "type": "string", "enum": ["15m", "1h", "24h", "never", "7d"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["code", "projectId", "projectTitle", "ownerId", "ownerName", "defaultRole", "enabled", "expiryPreset", "createdAt", "updatedAt"]
    },
    "CollabJoinRequest": {
      "title": "CollabJoinRequest",
      "description": "Yêu cầu tham gia dự án nhóm qua mã 4 chữ số hoặc liên kết cần chủ dự án chấp nhận",
      "type": "object",
      "properties": {
        "requesterUid": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "requesterName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "requesterPhotoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "requesterPublicLabel": { "type": "string", "maxLength": 120 },
        "source": { "type": "string", "enum": ["code", "link"] },
        "codeUsed": { "type": ["string", "null"], "maxLength": 4 },
        "inviteTokenUsed": { "type": ["string", "null"], "maxLength": 128 },
        "requestedRole": { "type": "string", "enum": ["editor", "viewer"] },
        "assignedRole": { "type": ["string", "null"], "enum": ["editor", "viewer", null] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "resolvedAt": { "type": ["string", "null"] },
        "resolvedBy": { "type": ["string", "null"], "maxLength": 128 }
      },
      "required": ["requesterUid", "projectId", "projectTitle", "requesterName", "requesterPublicLabel", "source", "requestedRole", "status", "createdAt", "updatedAt"]
    },
    "CollabBlockedUser": {
      "title": "CollabBlockedUser",
      "description": "Danh sách người dùng bị chủ dự án chặn không cho gửi yêu cầu hoặc tham gia lại",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "publicLabel": { "type": "string", "maxLength": 120 },
        "blockedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "publicLabel", "blockedBy", "createdAt"]
    },
    "PublicUserProfile": {
      "title": "PublicUserProfile",
      "description": "Hồ sơ tìm kiếm công khai (opt-in) dùng khi mời thành viên theo tên hoặc tên đăng nhập; không chứa email ảo",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "displayNameLower": { "type": "string", "minLength": 1, "maxLength": 100 },
        "username": { "type": ["string", "null"], "maxLength": 30 },
        "usernameLower": { "type": ["string", "null"], "maxLength": 30 },
        "photoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "hasVerifiedEmail": { "type": "boolean" },
        "allowProfileSearch": { "type": "boolean" },
        "allowEmailSearch": { "type": "boolean" },
        "acceptDirectInvites": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName", "displayNameLower", "hasVerifiedEmail", "allowProfileSearch", "allowEmailSearch", "acceptDirectInvites", "updatedAt"]
    },
    "EmailLookup": {
      "title": "EmailLookup",
      "description": "Bảng tra cứu 1-1 theo mã băm SHA-256 của email đã xác minh (cấm list)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "updatedAt"]
    },
    "CollabDirectInvite": {
      "title": "CollabDirectInvite",
      "description": "Lời mời trực tiếp do chủ dự án gửi tới người dùng (người nhận phải tự Chấp nhận)",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "projectTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "targetUid": { "type": "string", "maxLength": 128 },
        "targetName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "targetUsername": { "type": ["string", "null"], "maxLength": 30 },
        "targetPhotoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "inviterUid": { "type": "string", "maxLength": 128 },
        "inviterName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "inviterPhotoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "role": { "type": "string", "enum": ["editor", "viewer"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "revoked"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "respondedAt": { "type": ["string", "null"] }
      },
      "required": ["projectId", "projectTitle", "targetUid", "targetName", "inviterUid", "inviterName", "role", "status", "createdAt", "updatedAt"]
    },
    "UserInviteInboxItem": {
      "title": "UserInviteInboxItem",
      "description": "Bản ghi hộp thư lời mời dự án nhóm của người dùng nhận mời",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "projectTitle": { "type": "string", "minLength": 1, "maxLength": 60 },
        "targetUid": { "type": "string", "maxLength": 128 },
        "inviterUid": { "type": "string", "maxLength": 128 },
        "inviterName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "inviterPhotoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "role": { "type": "string", "enum": ["editor", "viewer"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "revoked"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "respondedAt": { "type": ["string", "null"] }
      },
      "required": ["projectId", "projectTitle", "targetUid", "inviterUid", "inviterName", "role", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Tài liệu hồ sơ và cài đặt giao diện người dùng"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Danh sách các dự án mã nguồn của người dùng"
    },
    "/users/{userId}/learning/{docId}": {
      "schema": "LearningProgress",
      "description": "Tiến trình học tập theo từng khóa học"
    },
    "/users/{userId}/userInvites/{projectId}": {
      "schema": "UserInviteInboxItem",
      "description": "Hộp thư lời mời tham gia dự án nhóm của người dùng"
    },
    "/users/{userId}/templatePrefs/{prefId}": {
      "schema": "TemplatePreferences",
      "description": "Mẫu yêu thích và mẫu dùng gần đây của người dùng"
    },
    "/publicProfiles/{uid}": {
      "schema": "PublicUserProfile",
      "description": "Hồ sơ tìm kiếm công khai (opt-in) dùng khi mời thành viên"
    },
    "/emailLookup/{emailHash}": {
      "schema": "EmailLookup",
      "description": "Tra cứu chính xác email đã xác minh qua mã băm SHA-256 (cấm list)"
    },
    "/collabProjects/{projectId}": {
      "schema": "CollabProject",
      "description": "Siêu dữ liệu, thành viên, vai trò và cấu hình lời mời của dự án nhóm"
    },
    "/collabProjects/{projectId}/updates/{updateId}": {
      "schema": "CollabUpdateChunk",
      "description": "Chuỗi gói cập nhật Yjs CRDT"
    },
    "/collabProjects/{projectId}/snapshots/{snapshotId}": {
      "schema": "CollabSnapshot",
      "description": "Ảnh chụp trạng thái Yjs đã được nén"
    },
    "/collabProjects/{projectId}/comments/{commentId}": {
      "schema": "CollabLineComment",
      "description": "Chuỗi bình luận gắn theo dòng mã trong dự án nhóm"
    },
    "/collabProjects/{projectId}/messages/{messageId}": {
      "schema": "CollabChatMessage",
      "description": "Tin nhắn trò chuyện ngắn giữa các thành viên dự án nhóm"
    },
    "/collabProjects/{projectId}/state/{stateId}": {
      "schema": "CollabPreviewState",
      "description": "Trạng thái đồng bộ chế độ xem trước của dự án nhóm"
    },
    "/collabInvites/{inviteToken}": {
      "schema": "CollabInvite",
      "description": "Tra cứu liên kết mời dự án nhóm theo token bí mật"
    },
    "/joinCodes/{code}": {
      "schema": "CollabJoinCode",
      "description": "Tra cứu dự án nhóm bằng mã 4 chữ số"
    },
    "/collabProjects/{projectId}/joinRequests/{requesterUid}": {
      "schema": "CollabJoinRequest",
      "description": "Yêu cầu tham gia dự án đang chờ chủ dự án phê duyệt"
    },
    "/collabProjects/{projectId}/invites/{targetUid}": {
      "schema": "CollabDirectInvite",
      "description": "Lời mời trực tiếp đã gửi tới người dùng (chờ người nhận chấp nhận)"
    },
    "/collabProjects/{projectId}/blockedUsers/{targetUid}": {
      "schema": "CollabBlockedUser",
      "description": "Danh sách người dùng đã bị chủ dự án chặn"
    }
  }
}
